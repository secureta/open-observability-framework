{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oof-ingest-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": ["**/*.wasm"],
      "fallthrough": true
    },
    {
      "type": "Text",
      "globs": ["**/*.yar"],
      "fallthrough": true
    }
  ],
  "pipelines": [
    {
      "binding": "TELEMETRY_STREAM",
      // Replace <STREAM_ID> with the Stream ID output by `provision-basin.sh`
      // or `npx wrangler basin pipelines streams list` (do NOT use the stream name).
      "stream": "<STREAM_ID>"
    }
  ]
}
