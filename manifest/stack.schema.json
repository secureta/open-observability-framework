{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-observability-framework.dev/schemas/stack/v0.1.json",
  "title": "Open Observability Framework Stack Manifest",
  "description": "Declarative manifest binding interchangeable SIEM + APM service adapters across framework slots with standard telemetry schemas.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "platform_name",
    "schema",
    "collect",
    "detect",
    "ingest",
    "storage",
    "apm",
    "query"
  ],
  "properties": {
    "version": {
      "type": "string",
      "const": "0.1"
    },
    "platform_name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
    },
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "version"],
      "properties": {
        "profile": {
          "type": "string",
          "enum": ["ocsf", "ecs", "cim"],
          "description": "Open telemetry schema standard (no proprietary custom schemas)."
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "class_uid": {
          "type": "integer",
          "minimum": 1,
          "description": "OCSF event class UID (e.g. 1008 for Event Log Activity)."
        },
        "contract_path": {
          "type": "string",
          "minLength": 1
        }
      },
      "if": {
        "properties": {
          "profile": { "const": "ocsf" }
        },
        "required": ["profile"]
      },
      "then": {
        "required": ["class_uid"]
      }
    },
    "collect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "sources"],
      "properties": {
        "adapter": {
          "type": "string",
          "minLength": 1,
          "description": "Collector service adapter (e.g. vector-journald, fluent-bit-journald, otel-collector-journald)."
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "options": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "detect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "placement": {
          "type": "string",
          "enum": ["host-agent", "lakehouse-batch", "edge-ingest", "hybrid"]
        },
        "engine": {
          "type": "string",
          "minLength": 1,
          "description": "Optional detection engine identifier (e.g. yara-x, kunai, sigma-sql)."
        },
        "rule_paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "if": {
        "properties": {
          "enabled": { "const": true }
        },
        "required": ["enabled"]
      },
      "then": {
        "required": ["placement", "engine"]
      }
    },
    "ingest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "auth"],
      "properties": {
        "adapter": {
          "type": "string",
          "minLength": 1,
          "description": "Ingestion transport adapter (default: direct-basin-http)."
        },
        "endpoint": {
          "type": "string",
          "minLength": 1
        },
        "auth": {
          "type": "string",
          "enum": ["basin-api-token", "access", "mtls"]
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "format", "namespace", "tables"],
      "properties": {
        "adapter": {
          "type": "string",
          "minLength": 1,
          "description": "Lakehouse/telemetry storage adapter (e.g. cloudflare-basin-iceberg)."
        },
        "format": {
          "type": "string",
          "enum": ["iceberg", "parquet"]
        },
        "catalog": {
          "type": "string",
          "minLength": 1
        },
        "bucket": {
          "type": "string",
          "minLength": 1
        },
        "namespace": {
          "type": "string",
          "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
        },
        "tables": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
          }
        },
        "options": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "apm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "traces_adapter": {
          "type": "string",
          "minLength": 1
        },
        "metrics_adapter": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "ai": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "description": "Optional AI / Coding-Agent observability slot based on OpenTelemetry GenAI Semantic Conventions.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "schema_profile": {
          "type": "string",
          "enum": ["otel-genai"],
          "description": "Standard AI telemetry schema profile (zero proprietary schemas)."
        },
        "capture_content": {
          "type": "string",
          "enum": ["none", "redacted", "full"],
          "description": "Prompt/completion capture policy (recommended: none for metadata-only usage tracking)."
        },
        "contract_path": {
          "type": "string",
          "minLength": 1
        },
        "collector_adapter": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "options": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "if": {
        "properties": {
          "enabled": { "const": true }
        },
        "required": ["enabled"]
      },
      "then": {
        "required": ["schema_profile", "capture_content", "contract_path"]
      }
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapters"],
      "properties": {
        "adapters": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
